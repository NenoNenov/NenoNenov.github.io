@inherits LayoutComponentBase

<header class="nav">
    <div class="container nav-inner">
        <a class="brand" href="#top" @onclick="CloseMenu">&lt;Neno Nenov /&gt;</a>
        <button class="menu-btn" aria-label="Toggle menu" aria-expanded="@menuOpen" @onclick="ToggleMenu">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </button>
        <nav class="@(menuOpen ? "links open" : "links")" aria-label="Main">
            <a href="#about" @onclick="CloseMenu">About</a>
            <a href="#projects" @onclick="CloseMenu">Projects</a>
            <a href="#certificates" @onclick="CloseMenu">Certificates</a>
            <a href="#contact" @onclick="CloseMenu">Contact</a>
        </nav>
    </div>
</header>

<main id="top">
    @Body
</main>

<footer class="footer">
    <div class="container">© @DateTime.Now.Year Neno Nenov · Built with C# and Blazor WebAssembly</div>
</footer>

@code {
    private bool menuOpen;
    private void ToggleMenu() => menuOpen = !menuOpen;
    private void CloseMenu() => menuOpen = false;
}
